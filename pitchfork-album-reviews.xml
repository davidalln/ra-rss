  <item>
    <title>Beyoncé – B’DAY (20th ANNIVERSARY EDITION)</title>
    <link>https://pitchfork.com/reviews/albums/beyonce-bday-20th-anniversary-edition/</link>
    <guid isPermaLink="true">https://pitchfork.com/reviews/albums/beyonce-bday-20th-anniversary-edition/</guid>
    <pubDate>Thu, 10 Sep 2026 04:03:00 +0000</pubDate>

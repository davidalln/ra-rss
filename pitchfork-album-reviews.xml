  <item>
    <title>Chat Pile – Who Loves the Sun</title>
    <link>https://pitchfork.com/reviews/albums/chat-pile-who-loves-the-sun/</link>
    <guid isPermaLink="true">https://pitchfork.com/reviews/albums/chat-pile-who-loves-the-sun/</guid>

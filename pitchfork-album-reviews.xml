  <item>
    <title>Cameron Winter – Live at Carnegie Hall</title>
    <link>https://pitchfork.com/reviews/albums/cameron-winter-live-at-carnegie-hall/</link>
    <guid isPermaLink="true">https://pitchfork.com/reviews/albums/cameron-winter-live-at-carnegie-hall/</guid>
    <pubDate>Fri, 09 Oct 2026 04:03:00 +0000</pubDate>

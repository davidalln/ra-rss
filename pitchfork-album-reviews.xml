  <item>
    <title>Pooh Shiesty – All Eyes on Shiest</title>
    <link>https://pitchfork.com/reviews/albums/pooh-shiesty-all-eyes-on-shiest/</link>
    <guid isPermaLink="true">https://pitchfork.com/reviews/albums/pooh-shiesty-all-eyes-on-shiest/</guid>
    <pubDate>Mon, 24 Aug 2026 04:00:00 +0000</pubDate>

  <item>
    <title>AZ Chike – No Rest for the Wicked</title>
    <link>https://pitchfork.com/reviews/albums/az-chike-no-rest-for-the-wicked/</link>
    <guid isPermaLink="true">https://pitchfork.com/reviews/albums/az-chike-no-rest-for-the-wicked/</guid>
    <pubDate>Thu, 24 Sep 2026 04:02:00 +0000</pubDate>
